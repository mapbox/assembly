{
  "extends": [
    "@mapbox/eslint-config-mapbox",
    "prettier"
  ],
  "rules": {
    "node/no-unsupported-features/es-syntax": [
      "error",
      { "ignores": ["dynamicImport"] }
    ]
  },
  "overrides": [
    {
      "files": ["*.mjs", "docs/.vitepress/**/*.js"],
      "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module"
      },
      "rules": {
        "node/no-unsupported-features/es-syntax": "off"
      }
    }
  ]
}
